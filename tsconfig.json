{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		// TypeScript does not add file extensions to package.json `imports` targets,
		// so mirror the `#lib` mapping here for type-checking.
		"paths": {
			"#lib": ["./src/lib"],
			"#lib/*": ["./src/lib/*"]
		},
		"sourceMap": true,
		"strict": true
	},
	"include": ["src", "test", "*"],
	"exclude": ["src/service-worker"]
}
